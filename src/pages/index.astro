---
import LinkList from '../components/LinkList.astro';
import { COLUMNS, COLUMN_IDS, columnUrl } from '../columns';
import { SITE_DESCRIPTION, SITE_HEADING } from '../consts';
import Base from '../layouts/Base.astro';
import { collections, games, tools } from '../links';
import { getPosts, postItem } from '../posts';

const posts = await getPosts();
// 归入专栏的内容（文章、合集、工具）只在专栏页存档，首页只留专栏入口
const loose = <T extends { column?: string }>(items: T[]) => items.filter((item) => !item.column);
const columns = COLUMN_IDS.map((id) => ({
	date: `${posts.filter((p) => p.data.column === id).length} 篇`,
	title: COLUMNS[id].title,
	href: columnUrl(id),
	note: COLUMNS[id].description,
}));
---

<Base>
	<section class="hero">
		<h1>{SITE_HEADING}</h1>
		<p>{SITE_DESCRIPTION}</p>
	</section>

	<LinkList heading="专栏 / Columns" items={columns} />
	<LinkList heading="合集 / Collections" items={loose(collections)} />
	<LinkList heading="游戏 / Games" items={loose(games)} />
	<LinkList heading="文章 / Posts" items={loose(posts.map(postItem))} />
	<LinkList heading="工具 / Tools" items={loose(tools)} />
</Base>
