---
import LinkList from '../../components/LinkList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, getTags, postItem } from '../../posts';

export async function getStaticPaths() {
	return (await getTags()).map(({ tag }) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getPosts()).filter((post) => post.data.tags.includes(tag));
---

<Base title={`#${tag}`} description={`带 #${tag} 的文章`}>
	<p class="crumb"><a href="/tags/">← 全部 Tags</a></p>
	<section class="hero">
		<h1>#{tag}</h1>
		<p>{posts.length} 篇文章</p>
	</section>
	<LinkList heading="文章 / Posts" items={posts.map(postItem)} showColumn />
</Base>
