---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { COLUMNS, columnUrl } from '../columns';
import { formatDate, postUrl, tagUrl } from '../posts';
import Base from './Base.astro';

interface Props {
	post: CollectionEntry<'posts'>;
	newer?: CollectionEntry<'posts'>;
	older?: CollectionEntry<'posts'>;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { column, tags } = post.data;
---

<Base title={post.data.title} description={post.data.description}>
	<header class="post-head">
		<h1>{post.data.title}</h1>
		<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
		{column && <a class="tag" href={columnUrl(column)}>{COLUMNS[column].short}</a>}
		{
			tags.length > 0 && (
				<p class="hashtags">
					{tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
				</p>
			)
		}
	</header>
	<article class="prose">
		<Content />
	</article>
	<nav class="post-nav">
		{older && <a href={postUrl(older)}>← {older.data.title}</a>}
		{newer && <a href={postUrl(newer)}>{newer.data.title} →</a>}
	</nav>
</Base>
