---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { docUrl } from '../kancolle-docs';
import Base from './Base.astro';

// 合集里的一页。doc.id 形如 2026summer/e1，目录页就是合集名 2026summer（规则见 src/kancolle-docs.ts）
interface Props {
	doc: CollectionEntry<'kancolle'>;
}
const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const title = headings.find((h) => h.depth === 1)?.text ?? doc.id.split('/').pop();
const [collection] = doc.id.split('/');
const isIndex = doc.id === collection;
---

<Base title={title}>
	<p class="crumb">
		<a href="/kancolle/">Kancolle 专栏</a>
		{!isIndex && <> / <a href={docUrl(collection)}>合集目录</a></>}
	</p>
	<article class="prose doc">
		<Content />
	</article>
</Base>
