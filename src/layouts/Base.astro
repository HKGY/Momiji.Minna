---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { SITE_DESCRIPTION, SITE_HEADING, SITE_TITLE } from '../consts';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** 分享卡片的类型：文章页用 article，其余用 website */
	type?: 'website' | 'article';
}
const { title, description = SITE_DESCRIPTION, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 分享到 X / Telegram 等平台时卡片上的图片，必须是完整网址。由 scripts/make-og.mjs 生成
const ogImage = new URL('/og.png', Astro.site);
const nav = [
	{ href: '/about/', label: 'About' },
	{ href: '/tags/', label: 'Tags' },
	{ href: '/friends/', label: 'Friends' },
	{ href: '/rss.xml', label: 'RSS' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
		<meta property="og:title" content={title ?? SITE_HEADING} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="600" />
		<meta property="og:image:height" content="600" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title ?? SITE_HEADING} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<div class="wrap">
			<header class="site-header">
				<a class="brand" href="/">
					<Image src={avatar} alt="" width={56} height={56} loading="eager" />
					{SITE_TITLE}
				</a>
				<nav>
					{
						nav.map(({ href, label }) => (
							<a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>
								{label}
							</a>
						))
					}
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<footer class="site-footer">
				© {new Date().getFullYear()} Kaguya Hana · Built with <a href="https://astro.build">Astro</a>
			</footer>
		</div>
		<script>
			// 点击正文图片在新标签页打开原尺寸
			document.querySelector('.prose')?.addEventListener('click', (e) => {
				const img = e.target instanceof HTMLImageElement ? e.target : null;
				if (img && !img.closest('a')) window.open(img.currentSrc || img.src, '_blank', 'noopener');
			});
		</script>
	</body>
</html>
